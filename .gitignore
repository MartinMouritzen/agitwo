# --- Large / external: ScummVM checkout (captured as patches/agitwo-scummvm.patch) ---
scummvm/

# --- Copyrighted game data (NEVER commit) ---
games/

# --- Generated voice audio (the distributable pack; ships via release/Nexus, not git) ---
*.mp3
*.wav
voices-out/

# --- Build / tool logs ---
*.log

# --- Editor / OS cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
node_modules/

# --- Scratch ---
/tmp/
*.tmp

# NOTE (public-release footgun): text/ and voices-src/*-lines.json contain
# verbatim Sierra game script (speaker-tagged). Fine in a PRIVATE repo. Strip
# them before making this repo public. See README "Distribution & legal".
__pycache__/
*.pyc
lab/audio/
lab-server.log

# secrets (Magnific MCP OAuth) - never commit
.mcp_client.json
.mcp_tokens.json
.elevenlabs.key

# generated/large distribution artifacts (keep dist/pkg source)
dist/voicepack/
dist/out/
dist/pkg/qfg1/

# marketing binaries (video/images live on disk, not git)
marketing/video/
marketing/images/

# --- Built distributables: 388 MB of per-platform binaries, rebuilt by the dist script and
#     shipped via the release/Nexus page. Same rule as voices-out/ above: never in git history. ---
dist/artifacts/

# --- Local agent/session state ---
.claude/
